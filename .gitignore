# ----------------------------
# Root Level (Ignore Everything Except Frontend)
# ----------------------------
server/
core/
data/
weights/
results/
docs/

# Ignore all Python-related files globally
__pycache__/
*.py[cod]
*.pkl
*.h5
*.pt
*.ckpt

# ----------------------------
# Next.js Frontend (client)
# ----------------------------
client/node_modules/
client/.next/
client/out/
client/.pnp
client/.pnp.js

# Logs
client/npm-debug.log*
client/yarn-debug.log*
client/yarn-error.log*
client/.pnpm-debug.log*

# Build outputs
client/dist/
client/build/

# Env files
client/.env
client/.env.local
client/.env.development.local
client/.env.test.local
client/.env.production.local

# ----------------------------
# OS / Misc
# ----------------------------
.DS_Store
Thumbs.db

# ----------------------------
# Keep ONLY frontend essentials
# ----------------------------
!client/
!client/package.json
!client/package-lock.json
!client/next.config.mjs
!client/tsconfig.json
!client/public/
!client/src/